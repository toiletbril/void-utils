#!/bin/sh

S="$1"
if test -z "$S"; then
  echo "hiiiii from xbps!!!!"
  exit 0
fi

F=''

case "$S" in
'search')
  S='query'
  F='-Rs'
  ;;
'clean')
  S='remove'
  F='-RoO'
  ;;
'files')
  S='query'
  F='-f'
  ;;
*);;
esac

if ! which xbps-"$S" > /dev/null 2>&1; then
  echo "error: there is no xbps-$S :(" >&2
  exit 1
fi

shift
xbps-"$S" $F "$@"
